# Supabase Auth project settings. Use the project's publishable/anon key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key

# PostgreSQL connection settings. Use Supabase's session pooler for a persistent backend.
user=postgres.your-project-ref
password=your-database-password
host=aws-0-region.pooler.supabase.com
port=5432
dbname=postgres

# Comma-separated frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
